---
import Container from "../../components/container/Container.astro";
import "./Hero.css";

import Button from "../../components/Button/Button.astro";

import heroDesktopAvif from "../../assets/images/hero/hero-desktop.avif";
import heroDesktopWebp from "../../assets/images/hero/hero-desktop.webp";

import heroMobileAvif from "../../assets/images/hero/hero-mobile.avif";
import heroMobileWebp from "../../assets/images/hero/hero-mobile.webp";

import "./Hero.css";
---

<section id="hero" class="hero" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true">
    <picture>
      <source
        media="(max-width: 768px)"
        srcset={heroMobileAvif.src}
        type="image/avif"
      />

      <source
        media="(max-width: 768px)"
        srcset={heroMobileWebp.src}
        type="image/webp"
      />

      <source
        media="(min-width: 769px)"
        srcset={heroDesktopAvif.src}
        type="image/avif"
      />

      <source
        media="(min-width: 769px)"
        srcset={heroDesktopWebp.src}
        type="image/webp"
      />

      <img
        src={heroDesktopWebp.src}
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </div>

  <div class="hero__overlay" aria-hidden="true"></div>

  <Container>
    <div class="hero__content">
      <header class="hero__heading-group">
        <p class="hero__eyebrow">AURA MARINA • SANTA MARTA</p>

        <div class="hero__title-wrapper">
          <h1 id="hero-title" class="hero__title">
            Tu casa frente al mar en <span class="hero__title-highlight"
              >Santa Marta</span
            > sin condiciones.
          </h1>

          <p class="hero__subtitle">
            Villas exclusivas en Santa Marta con espacios privados, piscina y un
            servicio pensado para tu tranquilidad.
          </p>
        </div>
      </header>

      <div class="hero__cta-wrapper">
        <Button href="#contacto"> Reservar visita </Button>

        <p class="hero__cta-note">
          Asegure su lugar en el Caribe más exclusivo.
        </p>
      </div>
    </div>
  </Container>
</section>
