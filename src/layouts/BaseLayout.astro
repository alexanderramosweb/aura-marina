---
import "../styles/main.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Aura Marina",
  description = "Proyecto residencial frente al mar.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>

    <meta name="description" content={description} />
  </head>

  <body>
    <slot />
  </body>
</html>
