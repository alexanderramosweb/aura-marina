---
import "../styles/main.css";
import openGraphImage from "../assets/images/seo/open-graph.webp";

interface Props {
  title?: string;
  description?: string;

  canonical?: string;
  ogImage?: string;

  siteName?: string;
}

const {
  title = "Aura Marina",
  description = "Proyecto residencial frente al mar.",

  canonical = "",

  ogImage = openGraphImage.src,

  siteName = "Aura Marina",
} = Astro.props;

//Schema.org

const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteName,
  description,
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <meta name="description" content={description} />

    <!-- Favicons -->

    <link rel="icon" href="/favicon_auramarina.ico" sizes="any" />

    <link rel="icon" href="/favicon_auramarina.svg" type="image/svg+xml" />

    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {canonical && <link rel="canonical" href={canonical} />}

    <!-- Open Graph - SEO social.-->

    <meta property="og:title" content={title} />

    <meta property="og:description" content={description} />

    <meta property="og:image" content={ogImage} />
    <!-- Esta es la miniatura. -->

    <meta property="og:type" content="website" />
    <!-- Le indica a Open Graph: Esto es un sitio web. -->

    <meta property="og:site_name" content={siteName} />
    <!-- Es el nombre oficial de la marca. -->

    <!-- Twitter Card -->

    <meta name="twitter:card" content="summary_large_image" />

    <meta name="twitter:title" content={title} />

    <meta name="twitter:description" content={description} />

    <meta name="twitter:image" content={ogImage} />

    <!-- Schema.org - SEO semántico para buscadores e IA.-->

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>

  <body>
    <slot />
    <script>
      Promise.all([import("../animations"), import("../smooth-scroll")]).then(
        ([animations, smoothScroll]) => {
          smoothScroll.initSmoothScroll();

          animations.initAnimations();
        },
      );
    </script>
  </body>
</html>
